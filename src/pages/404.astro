---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Zander Barajas" description="This page doesn't exist.">
  <section class="mt-10 sm:mt-16">
    <h1 class="text-[30px] leading-tight font-semibold tracking-tight">
      That page moved or never existed
    </h1>
    <p class="mt-3 text-muted-foreground">
      The old site's pages are gone, but everything is on the home page now.
    </p>
    <p class="mt-6">
      <a href="/" class="text-link underline underline-offset-2">
        Go home
      </a>
    </p>
  </section>
</BaseLayout>
