---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseStudyMeta from '@/components/CaseStudyMeta.astro';
import Hero from '@/components/media/Hero.astro';
import OnThisPage from '@/components/OnThisPage.astro';
import { getSortedProjects } from '@/lib/projects';
import { cachedReleaseDownloads, cachedRepoPushedAt, repoFromUrl } from '@/lib/github';
import { formatCountFloor } from '@/lib/format';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;

const liveDownloads = data.liveDownloads
  ? await cachedReleaseDownloads(data.liveDownloads.repo)
  : null;
const downloads = liveDownloads !== null ? formatCountFloor(liveDownloads) : undefined;
const sourceRepo = repoFromUrl(data.links.find((l) => l.label === 'Source')?.href ?? '');
const pushedAt = (sourceRepo && (await cachedRepoPushedAt(sourceRepo))) || undefined;
---

<BaseLayout
  title={`${data.title} | Zander Barajas`}
  description={data.summary}
  ogImage={`/og/${entry.id}.png`}
>
  <article class="pt-12 sm:pt-16">
    <p data-breadcrumb class="text-[13px] text-muted-foreground">
      <span class="text-cyan">$</span> cd{' '}
      <a href="/#work" class="hover:text-ink hover:underline">
        ~/work
      </a>
      /{entry.id}
    </p>
    <h1
      class="mt-4 text-[28px] leading-[1.15] font-extrabold tracking-tight sm:text-[36px] lg:text-[40px]"
      transition:name={`project-${entry.id}`}
    >
      {data.title}
    </h1>
    <p class="mt-3 max-w-[60ch] text-[14px] text-muted-foreground lg:text-[15px]">{data.summary}</p>
    {data.hero && <Hero id={entry.id} hero={data.hero} />}
    <div class="mt-10 lg:mt-14 lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-x-12">
      <aside
        data-sidebar
        class="rounded-lg border border-rule bg-panel p-5 lg:sticky lg:top-8 lg:self-start"
      >
        <CaseStudyMeta data={data} downloads={downloads} pushedAt={pushedAt} />
        <OnThisPage headings={headings} />
      </aside>
      <div data-main class="mt-10 min-w-0 lg:mt-0">
        <div class="case-prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
