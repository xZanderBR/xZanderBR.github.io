---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectIndex from '@/components/ProjectIndex.astro';
import OtherProjects from '@/components/OtherProjects.astro';
import Experience from '@/components/Experience.astro';
import { profile } from '@/data/profile';
import { getSortedProjects } from '@/lib/projects';
import { cachedReleaseDownloads } from '@/lib/github';
import { formatCountFloor } from '@/lib/format';
import { homeJsonLd } from '@/lib/structured-data';

const projects = await getSortedProjects();
const jsonLd = JSON.stringify(homeJsonLd(profile, new URL('/', Astro.site).href)).replace(
  /</g,
  '\\u003c',
);

// Live numbers where a project has them; the frontmatter value is the fallback.
const proofOverrides: Record<string, string> = {};
for (const { id, data } of projects) {
  if (!data.liveDownloads) continue;
  const downloads = await cachedReleaseDownloads(data.liveDownloads.repo);
  if (downloads !== null) proofOverrides[id] = formatCountFloor(downloads);
}
---

<BaseLayout
  title={profile.name}
  description="Zander Barajas, software engineer in San Diego. Projects, experience and resume."
>
  <section class="mt-12 sm:mt-20 lg:mt-24">
    <h1 class="max-w-[36ch] text-[28px] leading-[1.15] font-semibold tracking-tight sm:text-[36px] lg:text-[40px]">
      {profile.hero}
    </h1>
    <p class="mt-4 text-[17px] text-muted-foreground">{profile.context}</p>
  </section>

  <ProjectIndex projects={projects} proofOverrides={proofOverrides} />

  <!-- Desktop: Experience on the left; About and other projects beside it. Phones stack them. -->
  <div class="mt-12 lg:mt-24 lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-x-16">
    <Experience />
    <div class="mt-12 lg:mt-0">
      <section id="about" aria-labelledby="about-heading" class="scroll-mt-6">
        <h2 id="about-heading" class="mb-3 text-[15px] font-semibold">
          About
        </h2>
        <p class="max-w-[65ch]">{profile.about}</p>
      </section>
      <OtherProjects />
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLd} />
</BaseLayout>
