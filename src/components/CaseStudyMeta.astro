---
import type { ProjectData } from '@/lib/schema';

export interface Props {
  data: ProjectData;
  pushedAt?: string;
  downloads?: string;
}

const { data, pushedAt, downloads } = Astro.props;

const rows: { term: string; value: string }[] = [
  { term: 'Role', value: data.role },
  { term: 'Team', value: data.team },
  { term: 'Dates', value: data.dates },
  { term: 'Stack', value: data.stack.join(', ') },
  ...(downloads ? [{ term: 'Downloads', value: downloads }] : []),
  ...(pushedAt ? [{ term: 'Updated', value: pushedAt }] : []),
];
---

<dl class="grid grid-cols-[6rem_minmax(0,1fr)] gap-x-4 gap-y-2 border-y border-rule py-4 text-[15px] lg:block lg:border-y-0 lg:py-0">
  {rows.map((r) => (
    <>
      <dt class="text-muted-foreground lg:mt-4 lg:text-[13px] lg:first:mt-0">{r.term}</dt>
      <dd>{r.value}</dd>
    </>
  ))}
  {data.links.length > 0 && (
    <>
      <dt class="text-muted-foreground lg:mt-4 lg:text-[13px]">Links</dt>
      <dd class="flex flex-wrap gap-x-4 gap-y-1">
        {data.links.map((l) => (
          <a href={l.href} rel="noopener" class="text-link underline-offset-2 hover:underline">
            {l.label}
          </a>
        ))}
      </dd>
    </>
  )}
</dl>
