---
import type { ProjectData } from '@/lib/schema';

export interface Props {
  data: ProjectData;
  pushedAt?: string;
  downloads?: string;
}

const { data, pushedAt, downloads } = Astro.props;

const rows: { term: string; value: string }[] = [
  { term: 'Role', value: data.role },
  { term: 'Team', value: data.team },
  { term: 'Dates', value: data.dates },
  { term: 'Stack', value: data.stack.join(', ') },
  ...(downloads ? [{ term: 'Downloads', value: downloads }] : []),
  ...(pushedAt ? [{ term: 'Updated', value: pushedAt }] : []),
];
---

<dl class="grid grid-cols-[6rem_minmax(0,1fr)] gap-x-4 gap-y-2 text-[13px] lg:block">
  {rows.map((r) => (
    <>
      <dt class="text-cyan lg:mt-3 lg:first:mt-0">{r.term}:</dt>
      <dd class="text-ink">{r.value}</dd>
    </>
  ))}
  {data.links.length > 0 && (
    <>
      <dt class="text-cyan lg:mt-3">Links:</dt>
      <dd class="flex flex-wrap gap-x-4 gap-y-1">
        {data.links.map((l) => (
          <a
            href={l.href}
            rel="noopener"
            class="text-ink underline underline-offset-2 hover:text-cyan"
          >
            {l.label}
          </a>
        ))}
      </dd>
    </>
  )}
</dl>
