---
export interface Props {
  title: string;
  description: string;
  height: number;
  // Each diagram has a wide layout (640px and up) and a tall one for phones.
  layout?: 'wide' | 'tall';
}

const { title, description, height, layout = 'wide' } = Astro.props;
const width = layout === 'wide' ? 680 : 340;
const id = (name: string) => `diagram-${name}-${layout}`;
---

<figure class:list={['not-prose my-6', layout === 'wide' ? 'hidden sm:block' : 'sm:hidden']}>
  <svg
    role="img"
    aria-labelledby={`${id('title')} ${id('desc')}`}
    viewBox={`0 0 ${width} ${height}`}
    class:list={['block h-auto w-full text-ink', layout === 'tall' && 'mx-auto max-w-[400px]']}
    font-family="inherit"
  >
    <title id={id('title')}>{title}</title>
    <desc id={id('desc')}>{description}</desc>
    <defs>
      <marker
        id={id('arrowhead')}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" style="fill: var(--muted)"></path>
      </marker>
    </defs>
    <slot />
  </svg>
</figure>
