---
export interface Props {
  x: number;
  y: number;
  w: number;
  h?: number;
  label: string;
  sub?: string;
  accent?: boolean;
}

const { x, y, w, h = 52, label, sub, accent = false } = Astro.props;
const cx = x + w / 2;
const cy = y + h / 2;
---

<g data-node>
  <rect
    x={x}
    y={y}
    width={w}
    height={h}
    rx="6"
    fill="none"
    style={`stroke: var(${accent ? '--accent' : '--muted'}); stroke-width: ${accent ? 1.5 : 1}`}
  ></rect>
  <text
    x={cx}
    y={sub ? cy - 4 : cy + 5}
    text-anchor="middle"
    font-size="13"
    font-weight="600"
    fill="currentColor"
  >
    {label}
  </text>
  {sub && (
    <text x={cx} y={cy + 13} text-anchor="middle" font-size="12" style="fill: var(--muted)">
      {sub}
    </text>
  )}
</g>
