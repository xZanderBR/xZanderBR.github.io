---
// The licensing row's home page thumbnail: requests per day as a line. Decorative.
import { licensingStats } from '@/lib/stats';
import { sparklinePath } from '@/lib/charts';

const values = licensingStats.days.map((d) => d.requests);
const line = sparklinePath(values, 80, 50, 6);
const area = `${line}L74 50L6 50Z`;
---

<svg viewBox="0 0 80 50" preserveAspectRatio="none" class="block h-full w-full" aria-hidden="true">
  <path d={area} style="fill:var(--accent);opacity:0.1"></path>
  <path
    d={line}
    fill="none"
    style="stroke:var(--accent);stroke-width:1.5;stroke-linejoin:round;stroke-linecap:round"
    vector-effect="non-scaling-stroke"
  ></path>
</svg>
