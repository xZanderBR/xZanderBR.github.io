---
// The Struc-AI row's home page thumbnail: the catch chart in miniature. Decorative.
import { strucaiCatches } from '@/lib/stats';

const { categories } = strucaiCatches;
const most = Math.max(...categories.map((c) => c.total));
const rowH = 50 / categories.length;
const span = 64;
---

<svg viewBox="0 0 80 50" class="block h-full w-full" aria-hidden="true">
  {categories.map((c, i) => {
    const y = i * rowH + rowH / 2 - 2.5;
    return (
      <>
        <rect
          x="8"
          y={y}
          width={(c.total / most) * span}
          height="5"
          rx="1.5"
          style="fill:color-mix(in oklab, var(--accent) 18%, var(--paper))"
        />
        <rect
          x="8"
          y={y}
          width={(c.caught / most) * span}
          height="5"
          rx="1.5"
          style="fill:var(--accent)"
        />
      </>
    );
  })}
</svg>
