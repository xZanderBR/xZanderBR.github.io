---
// Struc-AI's score on the archive, by kind of check: how many of the known issues it caught.
// Each track is that kind's known issues, on one shared scale; the fill is what it caught.
import { strucaiCatches } from '@/lib/stats';

const { categories, projects } = strucaiCatches;
const caught = categories.reduce((a, c) => a + c.caught, 0);
const total = categories.reduce((a, c) => a + c.total, 0);
const most = Math.max(...categories.map((c) => c.total));
const pct = (n: number) => `${(n / most) * 100}%`;
const summary = `Known issues caught, by kind of check: ${categories
  .map((c) => `${c.label}, ${c.caught} of ${c.total}`)
  .join('; ')}. ${caught} of ${total} in all.`;
---

<figure data-chart class="not-prose rounded-lg border border-rule p-4 sm:p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="text-[15px] font-semibold">Known issues caught, by kind of check</p>
    <p class="text-[13px] text-muted-foreground">
      <span class="tabular">
        {caught} of {total}
      </span>{' '}
      across {projects} archived projects
    </p>
  </div>
  <div
    role="img"
    aria-label={summary}
    class="mt-5 grid gap-y-4 sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] sm:gap-x-5"
  >
    {categories.map((c) => (
      <>
        <span class="text-[14px] leading-snug sm:self-center">{c.label}</span>
        <span class="-mt-3 flex items-center gap-3 sm:mt-0">
          <span class="relative h-[10px] min-w-0 flex-1">
            <span
              class="absolute inset-y-0 left-0 rounded-r-[4px]"
              style={`width:${pct(c.total)};background:color-mix(in oklab, var(--accent) 18%, var(--paper))`}
            />
            <span
              class="absolute inset-y-0 left-0 rounded-r-[4px]"
              style={`width:${pct(c.caught)};background:var(--accent)`}
            />
          </span>
          <span class="tabular w-[4.5rem] shrink-0 text-right text-[13px] text-muted-foreground">
            {c.caught} of {c.total}
          </span>
        </span>
      </>
    ))}
  </div>
  <details class="mt-3 text-[13px] text-muted-foreground">
    <summary class="w-fit cursor-pointer hover:text-ink">Show the numbers</summary>
    <table class="data-table mt-2">
      <caption class="sr-only">Known issues caught, by kind of check</caption>
      <thead>
        <tr>
          <th scope="col">Kind of check</th>
          <th scope="col">Caught</th>
          <th scope="col">Known issues</th>
        </tr>
      </thead>
      <tbody>
        {categories.map((c) => (
          <tr>
            <th scope="row">{c.label}</th>
            <td>{c.caught}</td>
            <td>{c.total}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>
