---
// The preview on a home page row: 80x50 on phones, 160x100 on tablets, 240x150 on desktops.
// Decorative: the row's own text names the project.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Sparkline from '@/components/charts/Sparkline.astro';
import CatchMini from '@/components/charts/CatchMini.astro';

export interface Props {
  id: string;
  thumb?: CollectionEntry<'projects'>['data']['thumb'];
}

const { id, thumb } = Astro.props;
---

{!thumb && <span class="col-[1] row-[1/3] block sm:row-[1/5]" aria-hidden="true" />}
{thumb && (
  <span
    data-thumb
    class="col-[1] row-[1/3] block aspect-[8/5] w-full overflow-hidden rounded-md border border-rule bg-wash sm:row-[1/5]"
    transition:name={`visual-${id}`}
  >
    {thumb?.kind === 'image' && (
      <Image
        src={thumb.src}
        alt=""
        width={480}
        height={300}
        widths={[160, 320, 480]}
        sizes="(min-width: 1024px) 240px, (min-width: 640px) 160px, 80px"
        fit="cover"
        position="top"
        class="block h-full w-full object-cover"
      />
    )}
    {thumb?.kind === 'chart' && thumb.chart === 'licensing-sparkline' && <Sparkline />}
    {thumb?.kind === 'chart' && thumb.chart === 'strucai-mini' && <CatchMini />}
  </span>
)}
