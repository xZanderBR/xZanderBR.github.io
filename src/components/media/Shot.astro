---
// A screenshot. Astro serves it as AVIF or WebP at the size the screen needs, and its
// width and height are known up front so nothing moves when it loads.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  // The first visual on the page: load it right away instead of lazily.
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  priority = false,
  sizes = '(min-width: 768px) 672px, calc(100vw - 2rem)',
  class: className,
} = Astro.props;
---

<figure class:list={['not-prose', className ?? 'my-6']}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1344, 1920].filter((w) => w <= src.width)}
    sizes={sizes}
    priority={priority}
    class="block h-auto w-full rounded-lg border border-rule"
  />
  {caption && <figcaption class="mt-2 text-[14px] text-muted-foreground">{caption}</figcaption>}
</figure>
