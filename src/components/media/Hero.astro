---
// The wide visual under a case study's title, framed like a terminal window whose title is
// the file it shows.
import type { CollectionEntry } from 'astro:content';
import Shot from './Shot.astro';
import Clip from './Clip.astro';
import VideoEmbed from './VideoEmbed.astro';
import RequestsChart from '@/components/charts/RequestsChart.astro';
import CatchChart from '@/components/charts/CatchChart.astro';
import { sourceName } from '@/lib/images';

export interface Props {
  id: string;
  hero: NonNullable<CollectionEntry<'projects'>['data']['hero']>;
}

const { id, hero } = Astro.props;
const sizes = '(min-width: 1120px) 1054px, calc(100vw - 3rem)';
const chromeTitle =
  hero.kind === 'image'
    ? `${sourceName(hero.src.src)}.png`
    : hero.kind === 'clip'
      ? `${sourceName(hero.src)}.mp4`
      : hero.kind === 'youtube'
        ? `youtube.com/watch?v=${hero.id}`
        : hero.chart === 'licensing-requests'
          ? 'requests.log'
          : 'catches.log';
---

<div
  data-hero
  class="hero-frame mt-8 overflow-hidden rounded-lg border border-rule bg-panel lg:mt-12"
  transition:name={`visual-${id}`}
>
  <div
    data-chrome
    class="flex items-center gap-1.5 border-b border-rule px-4 py-2.5"
    aria-hidden="true"
  >
    <span class="size-2.5 rounded-full bg-rule"></span>
    <span class="size-2.5 rounded-full bg-rule"></span>
    <span class="size-2.5 rounded-full bg-rule"></span>
    <span class="flex-1 truncate pr-8 text-center text-[11px] text-muted-foreground">
      {chromeTitle}
    </span>
  </div>
  {hero.kind === 'image' && (
    <Shot src={hero.src} alt={hero.alt} sizes={sizes} priority class="m-0" />
  )}
  {hero.kind === 'clip' && <Clip src={hero.src} poster={hero.poster} alt={hero.alt} class="m-0" />}
  {hero.kind === 'youtube' && (
    <VideoEmbed id={hero.id} poster={hero.poster} title={hero.title} priority class="m-0" />
  )}
  {hero.kind === 'chart' && hero.chart === 'licensing-requests' && <RequestsChart />}
  {hero.kind === 'chart' && hero.chart === 'strucai-catches' && <CatchChart />}
</div>
