---
import { Search } from 'lucide-react';
---

<span class="inline-flex h-8 items-center gap-2 rounded-md border border-rule px-2 text-[13px] text-muted-foreground">
  <Search aria-hidden="true" className="size-4" />
  <span class="hidden sm:inline-flex">
    <kbd data-kbd="mac" class="font-sans">
      ⌘K
    </kbd>
    <kbd data-kbd="other" class="font-sans">
      Ctrl K
    </kbd>
  </span>
</span>
