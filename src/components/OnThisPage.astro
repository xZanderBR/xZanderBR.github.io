---
// Links to a case study's sections, for the sidebar on wide screens.
import type { MarkdownHeading } from 'astro';

export interface Props {
  headings: MarkdownHeading[];
}

const sections = Astro.props.headings.filter((h) => h.depth === 2);
---

<nav aria-label="On this page" class="mt-6 hidden border-t border-rule pt-5 text-[13px] lg:block">
  <p class="mb-2 text-muted-foreground" aria-hidden="true">
    <span class="text-cyan">#</span> sections
  </p>
  <ul class="space-y-1.5">
    {sections.map((h) => (
      <li>
        <a href={`#${h.slug}`} class="text-muted-foreground hover:text-cyan">
          {h.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
