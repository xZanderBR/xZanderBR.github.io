---
import { profile } from '@/data/profile';
---

<footer class="mt-24 border-t border-rule">
  <div class="shell flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-[12px] text-muted-foreground">
    <p>
      Built with Astro ·{' '}
      <a href={profile.sourceHref} rel="noopener" class="hover:text-ink hover:underline">
        source on GitHub
      </a>
    </p>
    <p>
      <span class="text-cyan">$</span> exit 0
    </p>
  </div>
</footer>
