---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchButton from '@/components/palette/SearchButton.astro';
import { profile } from '@/data/profile';
import { getSortedProjects } from '@/lib/projects';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  // For pages search engines shouldn't list, like the 404.
  noindex?: boolean;
}

const { title, description, ogImage = '/og/home.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const paletteProjects = (await getSortedProjects()).map(({ id, data }) => ({
  title: data.title,
  href: `/work/${id}/`,
  hint: data.stack.slice(0, 2).join(', '),
}));
const paletteLinks = [...profile.socials, { label: 'Source', href: profile.sourceHref }];
// Read by the palette when it first opens. "<" is escaped so the JSON can't end the tag.
const paletteData = JSON.stringify({
  projects: paletteProjects,
  email: profile.email,
  resumeHref: profile.resumeHref,
  links: paletteLinks,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-jetbrains" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Which keyboard shortcut to show (Cmd K or Ctrl K), set before paint and after each
      // client-side page swap.
      (() => {
        const apply = () => {
          document.documentElement.dataset.platform = /Mac|iPhone|iPad/.test(navigator.userAgent)
            ? 'mac'
            : 'other';
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-md bg-ink px-3 py-2 text-paper focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <Header>
      <SearchButton />
    </Header>
    <main id="main" tabindex="-1" class="shell outline-none">
      <slot />
    </main>
    <Footer />
    <div id="palette-root" transition:persist></div>
    <script type="application/json" id="palette-data" set:html={paletteData} />
  </body>
</html>
