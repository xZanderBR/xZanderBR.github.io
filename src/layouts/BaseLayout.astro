---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchButton from '@/components/palette/SearchButton.astro';
import { profile } from '@/data/profile';
import { getSortedProjects } from '@/lib/projects';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og/home.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const paletteProjects = (await getSortedProjects()).map(({ id, data }) => ({
  title: data.title,
  href: `/work/${id}/`,
  hint: data.stack.slice(0, 2).join(', '),
}));
const paletteLinks = [...profile.socials, { label: 'Source', href: profile.sourceHref }];
// Read by the palette when it first opens. "<" is escaped so the JSON can't end the tag.
const paletteData = JSON.stringify({
  projects: paletteProjects,
  email: profile.email,
  resumeHref: profile.resumeHref,
  links: paletteLinks,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        const media = matchMedia('(prefers-color-scheme: dark)');
        const stored = () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        };
        const apply = () => {
          const root = document.documentElement;
          const theme = stored();
          root.classList.toggle('dark', theme ? theme === 'dark' : media.matches);
          root.dataset.platform = /Mac|iPhone|iPad/.test(navigator.userAgent) ? 'mac' : 'other';
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        media.addEventListener('change', () => {
          if (!stored()) apply();
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="mx-auto max-w-[720px] px-4 sm:px-6">
      <Header>
        <SearchButton />
        <ThemeToggle />
      </Header>
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <div id="palette-root" transition:persist></div>
    <script type="application/json" id="palette-data" set:html={paletteData} />
  </body>
</html>
